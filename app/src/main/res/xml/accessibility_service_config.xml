<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares what the panel's accessibility service is allowed to do.

  It requests ONLY the multi-finger gesture family plus the global actions it
  needs (Home / Recents / Notifications). It deliberately does NOT request
  window-content retrieval or gesture dispatch — those are more invasive than this
  feature needs, and asking for them would make the permission scarier than it is.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestMultiFingerGestures"
    android:canPerformGestures="false"
    android:canRetrieveWindowContent="false"
    android:description="@string/a11y_service_description"
    android:notificationTimeout="100"
    android:summary="@string/a11y_service_summary" />
