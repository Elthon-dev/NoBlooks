<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Package visibility: NoBlooks only asks to see apps that expose a launcher entry
      point (MAIN + LAUNCHER) and other home candidates (MAIN + HOME).
      QUERY_ALL_PACKAGES is deliberately NOT declared.

      PACKAGE_USAGE_STATS: declaring it is what makes the "Usage access" toggle in
      Android settings apply to this app at all. It is never granted automatically;
      the habit page explains and opens the settings screen. No data ever leaves the
      device.

      RECORD_AUDIO: used ONLY by the user-initiated microphone level check on the
      Settings page. It is never requested at startup, there is no background
      recording, and no foreground service is started.

      No network, storage, accessibility, or overlay permissions.
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
      Shizuku: OPTIONAL elevated access for the control centre's radio tiles.
      Nothing is requested at startup; the tiles work read-only without it and the
      user grants it explicitly from the control centre. Declaring the permission
      is what lets Shizuku's manager show this app in its grant list.
    -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Wallpaper picker + the settings screens the UI can open on a tap. -->
        <intent>
            <action android:name="android.intent.action.SET_WALLPAPER" />
        </intent>
        <intent>
            <action android:name="android.settings.USAGE_ACCESS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.HOME_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OptiLauncher"
        android:hasCode="true">

        <!--
          The genuine Home activity. MAIN + HOME + DEFAULT makes the app eligible for
          Android's default Home selection; LAUNCHER lets it be opened from another
          launcher too. rotation/recreation is survived, not avoided (no configChanges
          swallowing), which is why the state holder is a ViewModel.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:taskAffinity=""
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true"
            android:alwaysRetainTaskState="true"
            android:stateNotNeeded="false"
            android:theme="@style/Theme.OptiLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shizuku's binder bridge. Harmless (and inert) when Shizuku is absent. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
          Notification reader for the control panel. Bound by the system only after
          the user grants notification access; until then it is simply never started
          and the panel shows an "access required" state. It never posts anything.
        -->
        <service
            android:name=".data.AppNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          The three-finger gesture and the panel's global Home/Recents/Shade actions.
          Declared but never enabled by the app: the user turns it on in Android's
          accessibility settings (the panel deep-links there). While disabled, the
          pill is still tapped directly and the gesture is simply inert.
        -->
        <service
            android:name=".data.AccessibilityPanelService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
