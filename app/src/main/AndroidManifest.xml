<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Package visibility: NoBlooks only asks to see apps that expose a launcher entry
      point (MAIN + LAUNCHER) and other home candidates (MAIN + HOME).
      QUERY_ALL_PACKAGES is deliberately NOT declared.

      PACKAGE_USAGE_STATS: declaring it is what makes the "Usage access" toggle in
      Android settings apply to this app at all. It is never granted automatically;
      the habit page explains and opens the settings screen. No data ever leaves the
      device.

      RECORD_AUDIO: used ONLY by the user-initiated microphone level check on the
      Settings page. It is never requested at startup, there is no background
      recording, and no foreground service is started.

      SYSTEM_ALERT_WINDOW: the always-on edge panel is drawn as a system overlay so
      it can appear over any app. Declaring it is what makes the app appear in
      "Display over other apps"; it is never granted automatically, and on API 34+
      the overlay is hosted by a foreground service (below) or the system tears it
      down. ColorOS can still refuse the window even when the permission is on —
      the app reports that state and never claims the overlay showed.

      FOREGROUND_SERVICE + FOREGROUND_SERVICE_SPECIAL_USE: required for that service
      on API 34+. `specialUse` is the honest type — this is not media, location or a
      call.

      RECEIVE_BOOT_COMPLETED: best-effort re-arm of the panel after a reboot. The
      ROM may block it; nothing is claimed if it does.
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Shizuku: OPTIONAL elevated access for the control centre's radio tiles.
      Nothing is requested at startup; the tiles work read-only without it and the
      user grants it explicitly from the control centre. Declaring the permission
      is what lets Shizuku's manager show this app in its grant list.
    -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Wallpaper picker + the settings screens the UI can open on a tap. -->
        <intent>
            <action android:name="android.intent.action.SET_WALLPAPER" />
        </intent>
        <intent>
            <action android:name="android.settings.USAGE_ACCESS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.HOME_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OptiLauncher"
        android:hasCode="true">

        <!--
          The genuine Home activity. MAIN + HOME + DEFAULT makes the app eligible for
          Android's default Home selection; LAUNCHER lets it be opened from another
          launcher too. rotation/recreation is survived, not avoided (no configChanges
          swallowing), which is why the state holder is a ViewModel.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:taskAffinity=""
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true"
            android:alwaysRetainTaskState="true"
            android:stateNotNeeded="false"
            android:theme="@style/Theme.OptiLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shizuku's binder bridge. Harmless (and inert) when Shizuku is absent. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
          Notification reader for the control panel. Bound by the system only after
          the user grants notification access; until then it is simply never started
          and the panel shows an "access required" state. It never posts anything.
        -->
        <service
            android:name=".data.AppNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          The three-finger gesture and the panel's global Home/Recents/Shade actions.
          Declared but never enabled by the app: the user turns it on in Android's
          accessibility settings (the panel deep-links there). While disabled, the
          pill is still tapped directly and the gesture is simply inert.
        -->
        <service
            android:name=".data.AccessibilityPanelService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          The always-on edge panel, hosted as a system overlay so it works over any
          app — not just inside the launcher. It is a foreground service because on
          API 34+ an overlay added from a background service is torn down silently.
          `specialUse` is the honest foreground type; the property below is what the
          platform requires for that type.
        -->
        <service
            android:name=".data.ComposeOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the edge control panel ready to appear over other apps" />
        </service>

        <!--
          Best-effort re-arm after a reboot. ColorOS and other ROMs may deliver this
          late or not at all; the panel simply stays off until the user opens the app
          or triggers the accessibility service again. We never claim it re-armed.
        -->
        <receiver
            android:name=".data.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
